# Copy to .env and fill in. Read by docker compose and by `npm run dev` in web/.

# Firebase web app config (Firebase console -> Project settings -> Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Mapbox public access token (pk.*) from account.mapbox.com -> Tokens. Used for maps + geocoding.
VITE_MAPBOX_ACCESS_TOKEN=
# Optional: map style URL. Defaults to mapbox://styles/mapbox/streets-v12.
VITE_MAPBOX_STYLE=

# Host port for the web app.
WEB_PORT=8080

# Local development only: lets the API accept the bearer token "dev". Never enable in production.
AUTH_DEV_BYPASS=false
